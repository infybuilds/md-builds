# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
#
# These are server-only names on purpose: no NEXT_PUBLIC_ prefix. Next.js inlines
# NEXT_PUBLIC_* into the bundle at build time, so prefixed variables cannot be
# supplied as runtime variables in production. Unprefixed names are read from
# process.env per request, so the same values work as Cloudflare runtime
# variables and secrets with no build configuration at all.

SUPABASE_URL=
# The publishable key (sb_publishable_...). Never a secret key (sb_secret_...).
SUPABASE_ANON_KEY=

# Absolute origin, used for canonical and Open Graph URLs.
# Defaults to http://localhost:3000 when unset.
SITE_URL=http://localhost:3000

# --- Advertising (optional) ---
# Ads render only when the publisher id AND that placement's slot id are both
# set, so leaving these blank ships no third-party script at all.
# Server-only names: the values reach the browser via server-rendered HTML.
# ADS_CLIENT_ID=ca-pub-0000000000000000
# ADS_SLOT_SIDEBAR=0000000000
# ADS_SLOT_ARTICLE_BOTTOM=0000000000
