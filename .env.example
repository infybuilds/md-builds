# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# The key below is the *publishable* key (sb_publishable_...), safe for browsers.
# Never use a secret key (sb_secret_...) here.
# .env.local is gitignored; never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL, used for canonical/Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Intentionally unused: this app relies on RLS + the user's session instead.
# If you ever add it, it must only ever be read in server-only code.
# SUPABASE_SERVICE_ROLE_KEY=
