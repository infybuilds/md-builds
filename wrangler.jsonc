{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "md-builds",
  "compatibility_date": "2026-09-01",
  // nodejs_compat is required: the app runs on the Node.js runtime (Next 16's
  // proxy has no edge option), and Supabase plus the Markdown pipeline use Node
  // built-ins. global_fetch_strictly_public makes fetch() to our own domain go
  // back out through the network rather than short-circuiting internally.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Without this, wrangler treats this file as the sole source of truth for
  // environment configuration and DELETES dashboard-set variables on every
  // deploy. Since SUPABASE_URL, SUPABASE_ANON_KEY and SITE_URL are configured in
  // the dashboard (and no "vars" block here declares them), each CI deploy was
  // wiping them — which made every route 500, because proxy.ts needs them.
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
  // No incremental cache binding, and so no WORKER_SELF_REFERENCE either (that
  // binding exists only to let cache revalidation call back into the worker).
  //
  // Every content route is server-rendered on demand, so there is little for a
  // page cache to hold: the index pages are force-dynamic and the admin pages
  // read cookies. Only /docs/[slug] and /workshops/[slug] would benefit.
  //
  // To add one later, Workers KV needs no R2 subscription:
  //   npx wrangler kv namespace create md-builds-cache
  // then add the returned id here...
  //   "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "<id>" }],
  //   "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "md-builds" }]
  // ...and in open-next.config.ts swap the incrementalCache override to
  //   "@opennextjs/cloudflare/overrides/incremental-cache/kv-incremental-cache"
}
